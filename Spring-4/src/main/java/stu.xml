<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="s1" class="com.demo.Student">
    
    
     <property name="id" value="101"></property>
     
     <property name="name" value="Ganesh"></property>
     
     <property name="address" value="Pune"></property> 
     
     <property name="subjects">
     
     <array>
     
     <value>JAVA</value>
     <value>Python</value>
     <value>C</value>
     <value>C++</value>
     
     </array>
     
     </property> 
     
     <property name="marks">
     
     <list>
     
     <value>90</value>
     <value>95</value>
     <value>80</value>
     <value>85</value>
     
     </list>
     
     </property> 
     
    
    </bean>
    
    <bean id="s2" class="com.demo.Student">
    
    
     <property name="id" value="102"></property>
     
     <property name="name" value="Ram"></property>
     
     <property name="address" value="Mumbai"></property> 
     
     <property name="subjects">
     
     <array>
     
     <value>JAVA</value>
     <value>Python</value>
     <value>C</value>
     <value>C++</value>
     
     </array>
     
     </property>   
     
     <property name="marks">
     
     <list>
     
     <value>90</value>
     <value>95</value>
     <value>80</value>
     <value>85</value>
     
     </list>
     
     </property>
     
    
    </bean>

</beans>